{
  "name": "pllingo", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "prepare:sheets": "tsx scripts/build-sheets.ts",
    "dev:pages": "tsx scripts/build-sheets.ts && vite --mode sheets --host 127.0.0.1",
    "build:pages": "tsx scripts/build-sheets.ts && tsc --noEmit && vite build --mode sheets",
    "prepare:github": "tsx scripts/prepare-github.ts",
    "preview:pages": "vite preview --mode sheets --host 127.0.0.1 --port 5174",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "materials": "python scripts/prepare_materials.py && python scripts/render_review.py && tsx scripts/analyze_materials.ts",
    "test": "tsx scripts/build-sheets.ts && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:sheets:e2e": "playwright test --config playwright.sheets.config.ts"
  },
  "dependencies": {
    "react": "^19.0.0", "react-dom": "^19.0.0", "express": "^4.21.2", "dotenv": "^16.4.7",
    "zod": "^3.24.2", "idb": "^8.0.2", "react-markdown": "^9.0.3", "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1", "katex": "^0.16.21", "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^5.7.3", "vite": "^6.1.0", "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.13.4", "@types/express": "^4.17.21", "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3", "tsx": "^4.19.3", "concurrently": "^9.1.2", "@playwright/test": "^1.51.0"
  }
}
